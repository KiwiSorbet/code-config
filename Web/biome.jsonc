{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {"enabled": true, "clientKind": "git", "useIgnoreFile": false},
    "files": {
        "includes": ["**", "!**/*bun.lock", "!build/**/*"],
        "ignoreUnknown": false,
        "maxSize": 20000000
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 90,
        "attributePosition": "auto",
        "bracketSpacing": false,
        "delimiterSpacing": false,
        "expand": "never",
        "trailingNewline": true,
        "useEditorconfig": true
    },
    "linter": {"enabled": true, "rules": {"preset": "recommended"}},
    "assist": {
        "enabled": true,
        "actions": {
            "recommended": true,
            "source": {
                "organizeImports": {"level": "on", "options": {}},
                "useSortedPackageJson": "on"
            }
        }
    },
    "html": {"formatter": {"enabled": true}},
    "css": {"formatter": {"enabled": true}},
    "javascript": {"formatter": {"enabled": true, "quoteStyle": "double"}},
    "json": {"formatter": {"enabled": true, "trailingCommas": "none"}}
}
